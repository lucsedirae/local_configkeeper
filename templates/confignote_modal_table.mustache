{{!
    @template plugintype_pluginname/template_name

    Template purpose and description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}

<div>
    <table class="table">
        <thead>
        <tr>
            <th scope="col">{{#str}}plugin, local_configkeeper{{/str}}: {{#str}}setting, local_configkeeper{{/str}}</th>
            <th scope="col">{{#str}}value, local_configkeeper{{/str}}</th>
            <th scope="col">{{#str}}note, local_configkeeper{{/str}}</th>
        </tr>
        </thead>
        {{#rows}}
            <tr>
                <td>{{{plugin}}}: {{{name}}}</td>
                <td>{{{value}}}</td>
                <td>
                    <textarea class="local-configkeeper-note" cols="40" rows="3" data-logid="{{id}}">
                        {{#note}}
                            {{{note}}}
                        {{/note}}
                        {{^note}}
                            {{#str}}leave_note, local_configkeeper{{/str}}
                        {{/note}}
                    </textarea>
                </td>
            </tr>
        {{/rows}}
    </table>
</div>
